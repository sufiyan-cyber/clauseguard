# --- LLM (Groq - free tier: https://console.groq.com/keys) ------------------
GROQ_API_KEY=gsk_...
# Optional model overrides
REASONING_MODEL=groq/openai/gpt-oss-120b
FAST_MODEL=groq/openai/gpt-oss-20b
# Fallback provider (demo-day insurance if Groq rate-limits): set both models
# to "featherless:<model-id>" and provide the key. Example:
#   REASONING_MODEL=featherless:openai/gpt-oss-120b
#   FAST_MODEL=featherless:openai/gpt-oss-20b
# FEATHERLESS_API_KEY=

# --- Qdrant (free cluster: https://cloud.qdrant.io) --------------------------
# For local dev you can run qdrant-local/qdrant.exe and use http://localhost:6333
QDRANT_URL=https://xxxx-xxxx.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=

# --- Enkrypt AI (https://app.enkryptai.com -> API keys) ----------------------
# Leave empty to run gates in local fallback mode (deterministic checks only).
ENKRYPT_API_KEY=
# ENKRYPT_ADHERENCE_THRESHOLD=0.6
# ENKRYPT_RELEVANCY_THRESHOLD=0.6

# --- Service security ---------------------------------------------------------
# Shared secret required from the web gateway on every /v1/* call.
# Must match AGENT_API_KEY in web/.env.local. Empty = auth disabled (local dev).
AGENT_API_KEY=change-me-shared-secret
# Allowed browser origin for CORS
WEB_ORIGIN=http://localhost:3000

# --- Storage (optional overrides; default = files in the agent package root) --
# On cloud hosts point everything at the persistent volume, e.g.:
#   DATABASE_URL=file:/data/clauseguard.db
#   APP_DATABASE_URL=file:/data/clauseguard-app.db
#   UPLOAD_DIR=/data/uploads
#   FASTEMBED_CACHE_DIR=/data/fastembed-cache
#   DISABLE_SPARSE=1   (skip the ~500MB SPLADE model on small volumes; dense-only)
PORT=4111
